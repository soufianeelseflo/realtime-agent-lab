{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-agent-lab.dev/schema/report-1.0.json",
  "title": "Realtime Agent Lab Evaluation Report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "sessionId", "score", "grade", "metrics", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sessionId": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "grade": { "enum": ["A+", "A", "B", "C", "D", "F"] },
    "metrics": { "type": "object" },
    "findings": { "type": "array" }
  }
}
