{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-agent-lab.dev/schema/session-1.0.json",
  "title": "Realtime Agent Lab Session",
  "type": "object",
  "required": [
    "specVersion",
    "id",
    "startedAt",
    "events"
  ],
  "properties": {
    "specVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "type"
        ],
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
